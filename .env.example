# Build-time configuration. Copy this file to `.env` and adjust as needed.
#
# Site identity now lives in the content repository,
# so that this generator becomes content-agnostic.
#
# The content repo file website.yaml is the source of truth for the metadata.
#
# This file contains required env variables for site building/deployment, 
# along with optional env variables to override website.yaml fields if needed.

# Required variables ==========================================================

# Build environment
# dev: building might skip optimization steps, and create example/ pages
SITE_ENV=dev
# prod: building will run all optimizations and validations
# SITE_ENV=prod

# Wherever you're placing the templates (you may use the included ones)
TEMPLATES_DIR=templates
# Wherever you're placing the assets (you may use the included ones)
ASSETS_DIR=assets

# Optional variables ==========================================================

# Overrides to content/website.yaml:
# SITE_NAME=Site title
# SITE_DESCRIPTION=Site description/subtitle
# SITE_AUTHOR=Person name
# SITE_COPYRIGHT_YEAR=Year where copyright starts
# SITE_DOMAIN=example.com
# TWITTER_HANDLE=username
# MATHJAX_VERSION=4.1.3
