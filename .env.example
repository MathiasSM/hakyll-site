# Build-time configuration. Copy this file to `.env` and adjust as needed.
#
# Site identity now lives in content/website.yaml (the source of truth); the
# variables below only override it, e.g. for a preview deployment.

# Where the content repo is checked out (defaults to content/)
CONTENT_DIR=content

# Build environment: dev also publishes the /example/ preview pages (default prod)
# SITE_ENV=dev

# Optional overrides to content/website.yaml:
# SITE_NAME=MathiasSM
# SITE_DESCRIPTION=Software Development Engineer
# SITE_AUTHOR=Mathias San Miguel
# SITE_COPYRIGHT_YEAR=2013
# SITE_DOMAIN=mathiassm.dev
# TWITTER_HANDLE=mathiassm
