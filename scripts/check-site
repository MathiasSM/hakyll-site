#!/usr/bin/env bash
# Builds the site from the fixture content in test/fixtures/content and compares the
# output with the golden snapshot in test/golden.
#
#   scripts/check-site            compare (exit 1 and show the diff if they differ)
#   scripts/check-site --update   regenerate test/golden from the current code
#
# PNG/ICO files are compared by pixel hash (ImageMagick output embeds timestamps);
# everything else byte for byte.
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
mode=${1:-check}
case "$mode" in check | --update) ;; *) echo "usage: $0 [--update]" >&2; exit 2 ;; esac

cd "$root"
cabal build exe:site -v0
site=$(cabal list-bin site)

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

# The site code reads templates/css/images/static and content/ from its working directory.
mkdir "$work/build"
cp -r templates css images static "$work/build/"
cp -r test/fixtures/content "$work/build/content"
(cd "$work/build" && "$site" build >"$work/build.log" 2>&1) || {
  cat "$work/build.log" >&2
  echo "check-site: the build failed" >&2
  exit 1
}

# Snapshot = every output file except PNG/ICO, plus the pixel hash of those.
snapshot="$work/snapshot"
mkdir "$snapshot"
(cd "$work/build/_site" && find . -type f ! -name '*.png' ! -name '*.ico' -print0 | xargs -0 cp --parents -t "$snapshot")
(cd "$work/build/_site" && find . -type f \( -name '*.png' -o -name '*.ico' \) | sort |
  while read -r file; do printf '%s %s\n' "$file" "$(convert "$file" -format %# info:)"; done) >"$snapshot/pixel-hashes.txt"

if [ "$mode" = "--update" ]; then
  rm -rf test/golden
  cp -r "$snapshot" test/golden
  echo "check-site: updated test/golden ($(find test/golden -type f | wc -l) files)"
elif diff -r test/golden "$snapshot"; then
  echo "check-site: output matches test/golden"
else
  echo "check-site: output differs from test/golden (run scripts/check-site --update if intended)" >&2
  exit 1
fi
