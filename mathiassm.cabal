cabal-version:      3.14

name:               mathiassm
version:            0.4.0.2
synopsis:           Custom site generator engine using Hakyll
description:
    Custom static site generator built with Hakyll.
    Source: <https://github.com/MathiasSM/hakyll-site>

homepage:           https://mathiassm.dev
bug-reports:        github.com/MathiasSM/hakyll-site/issues
category:           Data, Web

author:             Mathias San Miguel
maintainer:         mathiassanmiguel@gmail.com

extra-doc-files:    README.md, CHANGELOG.md
extra-source-files:
    templates/*.html
    templates/*.xml
    assets/css/*.css

license:            BSD-3-Clause
license-file:       LICENSE.txt

build-type:         Simple

source-repository head
  type:     git
  location: https://github.com/MathiasSM/hakyll-site

common shared
  default-language: GHC2024
  default-extensions:
    OverloadedStrings
    DeriveGeneric
  ghc-options:      -Wall -Wcompat -Wincomplete-record-updates

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:  MathiasSM.Accessibility
                  , MathiasSM.CleanURL
                  , MathiasSM.Compile
                  , MathiasSM.Config
                  , MathiasSM.Content
                  , MathiasSM.Feeds
                  , MathiasSM.Filters
                  , MathiasSM.Cli
                  , MathiasSM.Context
                  , MathiasSM.Context.Feeds
                  , MathiasSM.Context.Language
                  , MathiasSM.Context.Nav
                  , MathiasSM.Context.Project
                  , MathiasSM.Context.Site
                  , MathiasSM.Context.Lists
                  , MathiasSM.Metadata
                  , MathiasSM.Rules.Assets
                  , MathiasSM.Rules.Favicon
                  , MathiasSM.Rules.Feed
                  , MathiasSM.Rules.PostGroup
                  , MathiasSM.Rules.Redirects
                  , MathiasSM.Rules.Showcase
                  , MathiasSM.Rules.SinglePages
                  , MathiasSM.Rules.Sitemap
                  , MathiasSM.Rules.Static
                  , MathiasSM.Rules
                  , MathiasSM.Validate
                  , MathiasSM.Writings
                  , MathiasSM.Yaml
                  , MathiasSM.Yaml.Experience
                  , MathiasSM.Yaml.Hobby
                  , MathiasSM.Yaml.Project
                  , MathiasSM.Yaml.Social
                  , MathiasSM.Yaml.Website
  other-modules: Paths_mathiassm
  autogen-modules: Paths_mathiassm
  build-depends:    base         >= 4 && < 5
                  , aeson        >= 2.2 && < 3
                  , directory    >= 1.3 && < 2
                  , filepath     >= 1.5 && < 2
                  , mtl          >= 2.3 && < 3
                  , text         >= 2.1 && < 3
                  , time         >= 1.12 && < 2
                  , pandoc       >= 3.12 && < 4
                  , pandoc-types >= 1.23 && < 2
                  , tagsoup      >= 0.14 && < 1
                  , yaml         >= 0.11 && < 1
                  , hakyll       == 4.17.*

executable site
  import:           shared
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:    base
                  , hakyll
                  , mathiassm
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N

test-suite test
  import:           shared
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   test
  other-modules:    MathiasSM.TestUtils
                  , MathiasSM.AccessibilitySpec
                  , MathiasSM.CleanURLSpec
                  , MathiasSM.ContentSpec
                  , MathiasSM.FeedsSpec
                  , MathiasSM.MetadataSpec
                  , MathiasSM.RedirectsSpec
                  , MathiasSM.ValidateSpec
                  , MathiasSM.YamlSpec
                  , Golden
  build-depends:    base
                  , hakyll
                  , mathiassm
                  , tasty
                  , tasty-hunit
                  , tasty-golden
                  , tasty-quickcheck
                  , bytestring
                  , directory
                  , filepath
                  , temporary
                  , time
  ghc-options:      -threaded
