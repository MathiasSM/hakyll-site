cabal-version:      3.14

name:               mathiassm
version:            0.2.0
build-type:         Simple

license-file:       LICENSE.txt
author:             Mathias San Miguel
maintainer:         mathiassanmiguel@gmail.com
homepage:           https://mathiassm.dev

common shared
  default-language: GHC2024
  default-extensions:
    OverloadedStrings
    DeriveGeneric
  ghc-options:      -Wall -Wcompat -Wincomplete-record-updates

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:  MathiasSM.CleanURL
                  , MathiasSM.Compile
                  , MathiasSM.Config
                  , MathiasSM.Content
                  , MathiasSM.Feeds
                  , MathiasSM.Context
                  , MathiasSM.Context.Feeds
                  , MathiasSM.Context.Language
                  , MathiasSM.Context.Nav
                  , MathiasSM.Context.Project
                  , MathiasSM.Context.Site
                  , MathiasSM.Context.Tables
                  , MathiasSM.Metadata
                  , MathiasSM.Rules.Assets
                  , MathiasSM.Rules.Favicon
                  , MathiasSM.Rules.Feed
                  , MathiasSM.Rules.PostGroup
                  , MathiasSM.Rules.Redirects
                  , MathiasSM.Rules.Showcase
                  , MathiasSM.Rules.SinglePages
                  , MathiasSM.Rules.Sitemap
                  , MathiasSM.Site
                  , MathiasSM.Tsv
                  , MathiasSM.Validate
  autogen-modules: Paths_mathiassm
  other-modules: Paths_mathiassm
  build-depends:    base         >= 4 && < 5
                  , aeson        >= 2.2 && < 3
                  , directory    >= 1.3 && < 2
                  , filepath     >= 1.5 && < 2
                  , text         >= 2.1 && < 3
                  , time         >= 1.12 && < 2
                  , pandoc       >= 3.12 && < 4
                  , pandoc-types >= 1.23 && < 2
                  , tagsoup      >= 0.14 && < 1
                  , yaml         >= 0.11 && < 1
                  , hakyll       == 4.17.*

executable site
  import:           shared
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:    base
                  , hakyll
                  , mathiassm
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N

test-suite spec
  import:           shared
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test
  other-modules:    Support
                  , MathiasSM.CleanURLSpec
                  , MathiasSM.ContentSpec
                  , MathiasSM.FeedsSpec
                  , MathiasSM.MetadataSpec
                  , MathiasSM.RedirectsSpec
                  , MathiasSM.ValidateSpec
                  , MathiasSM.TsvSpec
  build-depends:    base
                  , mathiassm
                  , HUnit
                  , time

test-suite snapshot
  import:           shared
  type:             exitcode-stdio-1.0
  main-is:          Snapshot.hs
  hs-source-dirs:   test
  build-depends:    base
                  , hakyll
                  , mathiassm
                  , bytestring
                  , directory
                  , filepath
                  , process
                  , temporary
  ghc-options:      -threaded
